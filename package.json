{
  "name": "dnd-character-sheets",
  "version": "1.0.0",
  "private": true,
  "description": "A visual desktop character sheet manager for D&D sessions.",
  "engines": {
    "node": ">=22.12.0"
  },
  "androidVersionCode": 1,
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "desktop:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "desktop:start": "npm run build && electron .",
    "package:win": "npm run build && node scripts/build-windows.mjs",
    "package:linux": "npm run build && node scripts/build-linux.mjs",
    "package:linux:dir": "npm run build && electron-builder --linux dir --config.directories.output=release/linux",
    "android:sync": "npm run build && cap sync android",
    "android:build": "npm run android:sync && node scripts/build-android.mjs",
    "android:open": "cap open android",
    "package:android": "npm run android:build",
    "icons:generate": "node scripts/generate-icons.mjs"
  },
  "author": {
    "name": "F Works",
    "email": "337310929+FLS76@users.noreply.github.com",
    "url": "https://github.com/FLS76"
  },
  "homepage": "https://github.com/FLS76/dnd-character-sheets",
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/screen-orientation": "^8.0.1",
    "@capacitor/share": "^8.0.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.4.5",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.2",
    "rcedit": "^5.0.2",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.dndprogress.sheets",
    "productName": "DND Character Sheets",
    "publish": "never",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release/windows"
    },
    "linux": {
      "icon": "build/icons",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "synopsis": "Visual D&D character sheets",
      "artifactName": "DND Character Sheets-${version}.${ext}"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "afterPack": "scripts/after-pack.cjs",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "displayLanguageSelector": true,
      "installerLanguages": [
        "ru_RU",
        "en_US"
      ],
      "shortcutName": "DND Character Sheets",
      "installerIcon": "build/installerIcon.ico",
      "uninstallerIcon": "build/uninstallerIcon.ico",
      "include": "build/installer.nsh"
    }
  }
}
